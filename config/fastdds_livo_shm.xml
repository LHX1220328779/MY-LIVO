<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS profile for local LIVO playback (player -> image republish -> fastlivo_mapping).

  The builtin SHM transport (FASTDDS_BUILTIN_TRANSPORTS=SHM) has a 512 KB segment per participant.
  1.5 MB point clouds and 6 MB decoded images are then fragmented through that one segment; when it is
  full the sample is dropped and only repaired at the next heartbeat (3 s default). Long LIVO rounds
  saw seconds-late LiDAR sources ("Dropping queued/unmatched ... frame") and lost IMU samples (fatal
  0.87 s gap, truck28 t=443 s). A 128 MB segment carries whole samples without fragmentation, and a
  100 ms heartbeat bounds any remaining repair delay.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>livo_shm</transport_id>
      <type>SHM</type>
      <segment_size>134217728</segment_size>
      <port_queue_capacity>4096</port_queue_capacity>
      <maxMessageSize>16777216</maxMessageSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="livo_shm_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>livo_shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
  <data_writer profile_name="livo_writer" is_default_profile="true">
    <times>
      <heartbeatPeriod>
        <sec>0</sec>
        <nanosec>100000000</nanosec>
      </heartbeatPeriod>
    </times>
  </data_writer>
</profiles>
