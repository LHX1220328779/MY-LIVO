<?xml version="1.0"?>
<package format="3">
  <name>fast_livo</name>
  <version>0.1.0</version>
  <description>FAST-LIVO2 ROS 2 Humble adaptation for the Wuhu mine sensor suite.</description>
  <maintainer email="maintainer@example.com">MY-LIVO maintainer</maintainer>
  <license>GPL-2.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <exec_depend>ffmpeg_image_transport</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
